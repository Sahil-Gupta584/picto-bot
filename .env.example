# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Everything here is read by apps/backend/src/config.ts. If you add a variable,
# add it there and here in the same commit - a .env.example that lies is worse
# than none, because it is what a new contributor trusts.

# ── ArmorIQ ───────────────────────────────────────────────────────────────
# Falls back to ~/.armoriq/credentials.json (written by `armoriq login`).
ARMORIQ_API_KEY=

# The identity ArmorIQ records for every action. Both have defaults.
ARMORIQ_AGENT_ID=picto-agent
ARMORIQ_USER_ID=bot@picto.dev

# The names the two MCP servers are registered under in the ArmorIQ dashboard.
# invoke() sends these to the proxy, which routes by them. If either does not
# match a registered server exactly, every tool call fails with HTTP 500 and the
# SDK reports it as "MCP invocation failed: [object Object]".
#   npm run mcp:check   prints what the dashboard actually has
ARMORIQ_MCP_FS=picto-fs
ARMORIQ_MCP_REPO=picto-repo

# ── This server ───────────────────────────────────────────────────────────
PORT=8787

# Public HTTPS URL of this server. ArmorIQ's proxy and GitHub both run in the
# cloud and must reach it, so 127.0.0.1 will not work.
#   npm run tunnel          (ngrok http 8787)
# Update this, armoriq.yaml, the GitHub App webhook and the Slack interactivity
# URL together whenever the tunnel URL changes.
PICTO_PUBLIC_URL=

# Where per-session clones live. Deleted when a conversation goes cold.
PICTO_WORKSPACES=./.workspaces

# Session database - conversations, transcripts, approvals, webhook deliveries.
# SQLite, via Node's built-in node:sqlite. No server to run.
PICTO_DB=./.picto/picto.sqlite

# Diagnostic. Set to a file path to append every inbound MCP request, including
# the body the caller actually sent. Off when unset.
#
# This exists because a rejected request produces no server log at all: ArmorIQ's
# proxy appends a `_iam_context` envelope to the JSON-RPC message, the MCP SDK's
# strict schema rejects the whole message, and the only visible symptom is
# "MCP invocation failed: [object Object]" several layers away.
PICTO_MCP_TRACE=

# ── Model ─────────────────────────────────────────────────────────────────
# One OpenAI-compatible adapter, so this is a config change and not a code
# change. Google's OpenAI-compatible endpoint is what we run:
#   https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Models to try, in order, when the one above will not answer. Comma-separated.
#
# A run is a dozen or more model calls, and a provider counts a free allowance
# per model. When one model's quota is spent its siblings' is not, so a run that
# would otherwise die mid-task carries on with the next name here. Retries alone
# cannot fix a spent allowance - only another model can.
#
# Leave empty (the default) for a single-model setup; nothing is retried against
# a model that does not exist. Which models exist is a property of the account,
# not of the agent, which is why this is configuration.
#
# Run `npm run probe:models` to check the names against your key before relying
# on them - a retired model is invisible from inside the agent. gemini-2.0-flash,
# for instance, was withdrawn: it answers 404 and suggests a replacement.
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.8-flash
# Attempts against the LAST model in the chain before giving up. Earlier models
# are not retried: moving to the next one answers sooner than waiting.
# LLM_MAX_ATTEMPTS=3

# ── GitHub App ────────────────────────────────────────────────────────────
# The app can be installed on one repo, an org, or a user account. Each install
# is a separate installation with its own id and token, which is how one app
# serves many teams.
#
# Install:  https://github.com/apps/<app-slug>/installations/new
# Settings: https://github.com/settings/apps/<app-slug>
#
# Permissions: Contents=write, Issues=write, Pull requests=write, Metadata=read
# Events:      Issue comment
GITHUB_APP_ID=
# Optional. Resolved from the event's repository when unset.
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# The @handle a comment must mention to start a run.
GITHUB_MENTION=@picto-bot
# Only used by the local scripts when --repo is not passed.
GITHUB_REPO=

# Private key, from the app's "Key pairs" tab (not "Client secrets").
# Prefer base64 so newlines survive the deploy target:
#   base64 -w0 picto-bot.pem
GITHUB_APP_PRIVATE_KEY_B64=
# Or raw PEM with escaped newlines:
GITHUB_APP_PRIVATE_KEY=
# Or a path. Local development only.
GITHUB_PEM_PATH=

# ── Slack ─────────────────────────────────────────────────────────────────
# The approval surface. Without it a blocked action is simply final.
#
# api.slack.com/apps -> your app
#   OAuth & Permissions  -> Bot User OAuth Token
#   Basic Information    -> App Credentials -> Signing Secret
#   Basic Information    -> App Credentials -> Client ID  (for "Add to Slack")
#   Event Subscriptions / Interactivity -> <PICTO_PUBLIC_URL>/slack/interactions
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Verifies that a button click really came from Slack. Required - without it
# /slack/interactions refuses everything, because an unverified click is
# indistinguishable from a forged one.
SLACK_SIGNING_SECRET=
# How long a blocked run waits for a human before giving up. Default 30 minutes.
SLACK_APPROVAL_TIMEOUT_MS=1800000
