{
  "name": "@picto/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --include ../../packages/agent-core/dist --include ../../.env --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "github:check": "node --env-file=../../.env dist/scripts/github-check.js",
    "agent:plan": "node --env-file=../../.env dist/scripts/plan-check.js",
    "agent:drift": "node --env-file=../../.env dist/scripts/drift-check.js",
    "agent:local": "node --env-file=../../.env dist/scripts/run-local.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@picto/agent-core": "*",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsx": "^4.19.2"
  }
}
